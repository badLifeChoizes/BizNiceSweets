# backend/.dockerignore
# Files to exclude from the Docker build context.
# Keeps the image lean and prevents secrets from leaking into the image.

# Test files (not needed in production image)
tests/
.pytest_cache/
.ruff_cache/

# Python cache / compiled bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Local environment file — secrets must NOT be baked into the image (T-01-10)
# Operator supplies .env at runtime via compose env_file
.env

# Build artifacts
*.egg-info/
dist/
build/

# Editor / OS artifacts
*.log
.DS_Store
Thumbs.db
