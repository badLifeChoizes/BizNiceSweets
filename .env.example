# .env.example — BizNiceSweets APPLICATION configuration template
#
# The stack needs TWO env files (D-P5-10). Copy BOTH before running it:
#   cp .env.example    .env       # this file — app config + app secrets
#   cp .env.db.example .env.db    # database credentials, incl. POSTGRES_PASSWORD
#
# Read by the api container only. The db container reads .env.db alone, so the
# secrets below are never handed to the database container.
#
# IMPORTANT: Never commit .env to git — it is listed in .gitignore.
#            Only .env.example (this file, with placeholder values) is tracked.

# ---------------------------------------------------------------------------
# PostgreSQL connection — where to reach the server.
#
# The CREDENTIALS (POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD) live in
# .env.db, not here: they must be identical for the db and api containers, so
# they have exactly one home. Do NOT add POSTGRES_PASSWORD to this file — a
# second copy is a copy that can drift.
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Authentication (required — added in Phase 2). The api container will not
# start without JWT_SECRET and BNS_ADMIN_PASSWORD (no defaults).
# ---------------------------------------------------------------------------

# Signs access tokens (HS256). Generate a strong value, e.g.:
#   openssl rand -hex 32
# Rotating this invalidates all existing access tokens.
JWT_SECRET=changeme_generate_a_random_64_char_hex

# First-admin bootstrap (seeded idempotently on startup). Change the password.
BNS_ADMIN_EMAIL=admin@example.com
BNS_ADMIN_PASSWORD=changeme_first_admin_password

# Dev only: set true so the refresh cookie is NOT marked Secure, allowing
# session persistence over plain http://localhost. Leave unset/false in production.
# DEBUG=true
