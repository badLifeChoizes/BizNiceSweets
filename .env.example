# .env.example — BizNiceSweets operator configuration template
#
# Copy this file to .env and set real values before running the stack:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git — it is listed in .gitignore.
#            Only .env.example (this file, with placeholder values) is tracked.

# ---------------------------------------------------------------------------
# PostgreSQL connection (used by both compose and the backend application)
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=biznice
POSTGRES_USER=app

# Set a strong, unique password before deploying.
# The db container and api container both read this value.
POSTGRES_PASSWORD=changeme_in_production

# ---------------------------------------------------------------------------
# Authentication (required — added in Phase 2). The api container will not
# start without JWT_SECRET and BNS_ADMIN_PASSWORD (no defaults).
# ---------------------------------------------------------------------------

# Signs access tokens (HS256). Generate a strong value, e.g.:
#   openssl rand -hex 32
# Rotating this invalidates all existing access tokens.
JWT_SECRET=changeme_generate_a_random_64_char_hex

# First-admin bootstrap (seeded idempotently on startup). Change the password.
BNS_ADMIN_EMAIL=admin@example.com
BNS_ADMIN_PASSWORD=changeme_first_admin_password

# Dev only: set true so the refresh cookie is NOT marked Secure, allowing
# session persistence over plain http://localhost. Leave unset/false in production.
# DEBUG=true
