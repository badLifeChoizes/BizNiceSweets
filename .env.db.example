# .env.db.example — BizNiceSweets DATABASE credentials template (D-P5-10)
#
# Copy this file to .env.db and set a real password before running the stack:
#   cp .env.db.example .env.db
#
# WHY THIS FILE IS SEPARATE FROM .env
#   The Postgres container needs the database credentials and nothing else. It has
#   no use for JWT_SECRET or BNS_ADMIN_PASSWORD, so those stay in .env, which only
#   the api container reads. Keeping the split means the auth master key is never
#   handed to the database container.
#
#   The api container reads BOTH files, because it needs the app secrets AND the
#   database credentials. POSTGRES_PASSWORD therefore has exactly ONE home: here.
#
# WHY NOT JUST INTERPOLATE ${POSTGRES_PASSWORD} IN compose.yml
#   Compose resolves ${...} against the compose file's own directory (compose/),
#   where no .env lives, so it silently expands to the empty string. An ALREADY
#   INITIALIZED Postgres volume starts fine without a password, so the fault is
#   invisible for the whole life of a volume and breaks only a FRESH one — i.e.
#   only ever on someone's first deploy. That was defect U0 (v4.0 Phase 5).
#
# IMPORTANT: Never commit .env.db to git — it is listed in .gitignore.
#            Only .env.db.example (this file, with a placeholder) is tracked.

# ---------------------------------------------------------------------------
# PostgreSQL credentials — read by the db container AND the api container
# ---------------------------------------------------------------------------
POSTGRES_DB=biznice
POSTGRES_USER=app

# Set a strong, unique password BEFORE the first `up`. Postgres bakes this into
# the data directory on first initialization; changing it afterwards requires an
# ALTER USER (or destroying the volume with `down -v`).
POSTGRES_PASSWORD=changeme_in_production
