# eslint-plugin-react-hooks is pinned to v5 (owner decision D-P1-1) but its peer
# range predates ESLint 10; the hooks rules are eslint-version-agnostic in practice.
# legacy-peer-deps keeps `npm install`/`npm ci` reproducible and stops npm from
# pruning auto-installed peers (e.g. @testing-library/dom) on every install.
legacy-peer-deps=true
