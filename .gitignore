# Environment / secrets — NEVER commit .env (only .env.example is tracked)
.env

# Frontend build artifacts and dependencies
node_modules/
dist/
frontend/node_modules/
frontend/dist/
# shadcn CLI generates files to frontend/@/ when alias resolution fails; ignore it
frontend/@/

# Python cache / bytecode
backend/__pycache__/
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/

# Archives and backups
*.zip
*.bak
*.backup

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/

# Local settings (keep .claude/settings.json but ignore local overrides)
.claude/settings.local.json
# Harness-generated conversation backups
.claude/backups/

# ZJ generated artifacts (regenerable from .zj/ — not source of truth)
.zj/atlas/
.zj/logs/timeline.html

# UAT / test-feedback export scratch (regenerated by exercising the app)
plum/docs/test-feedback/

# Temporary files
*.tmp
*.temp
*~
